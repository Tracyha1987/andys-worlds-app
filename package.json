{
  "name": "andys-worlds",
  "version": "1.0.0",
  "private": true,
  "description": "Andy's Worlds - learning boss-battle game for grades 4-10",
  "scripts": {
    "fonts": "node scripts/copy-fonts.js",
    "icons": "capacitor-assets generate --ios --iconBackgroundColor '#0b1550' --splashBackgroundColor '#0b1550' --splashBackgroundColorDark '#0b1550'",
    "sync": "npm run fonts && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/haptics": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@fontsource/baloo-2": "^5.0.0"
  }
}
